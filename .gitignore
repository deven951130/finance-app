# ============================================
# 個人資料保護：這些檔案絕對不能進 git
# ============================================

# SQLite 資料庫（裡面是你的真實財務資料）
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 存放資料庫的資料夾，整個排除
data/

# 匯出或備份的個人資料（之後若加入匯出功能也不會被誤傳）
*.csv
*.xlsx
*.xls
backup/
backups/
exports/

# 密碼、金鑰等環境設定
.env
.env.*
.streamlit/secrets.toml

# ============================================
# Python 與工具產生的檔案
# ============================================
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/

# 編輯器與作業系統產生的檔案
.vscode/
.idea/
.DS_Store
Thumbs.db
